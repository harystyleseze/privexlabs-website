# Allowlist: everything is excluded unless re-included below. This keeps the
# build context small and makes it impossible for .env files, .git, host
# node_modules (darwin binaries) or .redwood caches to reach the image.
#
# If the web build starts needing another file (e.g. a root babel.config.js),
# add a `!path` line here; the build fails loudly until you do.
*

!package.json
!yarn.lock
!.yarnrc.yml
!redwood.toml
!api/package.json

!web/package.json
!web/vite.config.ts
!web/tsconfig.json
!web/src
!web/public

!docker/nginx

# Never ship these even inside re-included folders.
**/node_modules
**/dist
**/.DS_Store
**/*.test.ts
**/*.test.tsx
