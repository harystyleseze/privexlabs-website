# PrivexLabs Docker scripts: configuration
#
# Every value below is the default, so this file is optional. To override:
#   cp scripts/docker/.env.example scripts/docker/.env    (git-ignored)
# Variables already set in your shell take precedence over this file.
# Format: KEY=value, one per line, no `export`. The file is parsed, never
# executed. Never put credentials here: use `docker login`.

# --- Image registry ----------------------------------------------------------
# The image is published as $REGISTRY/$IMAGE_NAMESPACE/$IMAGE_NAME.
# Log in once before pushing:  docker login $REGISTRY
#
# Examples:
#   Docker Hub org:   REGISTRY=docker.io  IMAGE_NAMESPACE=privexlabs
#   Docker Hub user:  REGISTRY=docker.io  IMAGE_NAMESPACE=harystyles
#   GitHub (GHCR):    REGISTRY=ghcr.io    IMAGE_NAMESPACE=<github-owner>
REGISTRY=docker.io
IMAGE_NAMESPACE=privexlabs
IMAGE_NAME=privexlabs-web

# Target platform of the production image. SecretVM runs linux/amd64.
PLATFORM=linux/amd64

# --- Ports -------------------------------------------------------------------
# Host port for the dev server (dev.sh). Change it if 8910 is already in use
# (e.g. by another Redwood app's dev server).
PRIVEXLABS_DEV_PORT=8910
# Host port the production container is published on (prod.sh /
# docker-compose.prod.yml). Use 127.0.0.1:8080 to publish on loopback only.
PRIVEXLABS_PROD_PORT=8080

# --- SecretVM ------------------------------------------------------------------
# Used by `secretvm.sh verify` and the portal instructions. The routed domain
# itself is set in docker-compose.secretvm.yml (the `routes` config).
SECRETVM_DOMAIN=privexlabs.com
